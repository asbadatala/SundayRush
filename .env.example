# --- API (FastAPI) ---
DATABASE_URL=postgresql+psycopg://sundayrush:sundayrush@localhost:5442/sundayrush
# Long random string; signs the anonymous session cookie and OAuth state.
SESSION_SECRET=change-me
# Fernet key for encrypting Yahoo tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Must match the browser origin (Next.js proxies /api/* to FastAPI).
WEB_BASE_URL=https://localhost:3200
COOKIE_SECURE=true

# Yahoo app (developer.yahoo.com/apps/create, Fantasy Sports: Read)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:3200/api/providers/yahoo/auth/callback

# 1 = fixture-backed NFL data + fake Yahoo OAuth/API (tests, E2E, offline demo)
FIXTURE_MODE=0
LOG_LEVEL=INFO
LOG_JSON=true

# --- Web (Next.js) ---
# Where Next.js rewrites /api/* to.
API_URL=http://127.0.0.1:8000
